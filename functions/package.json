{
  "name": "studypartner-functions",
  "scripts": {
    "lint": "tslint \"src/**/*.ts\"",
    "build": "tsc",
    "serve": "npm run build && firebase serve --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "mocha -r ts-node/register --timeout 15000 'test/**/*.test.ts'",
    "test:rules": "mocha -r ts-node/register --timeout 15000 'test/**/*.test.ts'"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "mocha": "^10.8.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "private": true
}
